{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Streamlit Dashboard",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "streamlit", "run", "scripts/dashboard.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}